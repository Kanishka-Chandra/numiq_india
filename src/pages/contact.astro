---
import ContactForm from "@components/Contact/ContactForm.astro";
import ContactInfo from "@components/Contact/ContactInfo.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout>
  <section
    class="relative flex min-h-[50vh] items-center justify-center overflow-hidden"
  >
    <img
      src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2071&q=80"
      alt="Modern financial district"
      class="absolute inset-0 -z-20 size-full object-cover opacity-90"
    />
    <div
      class="absolute inset-0 -z-10 bg-linear-to-b from-white/90 to-white/70"
    >
    </div>

    <div class="relative z-10 px-8 pt-20 text-center md:px-16 md:pt-10">
      <span
        class="border-brand-teal/30 text-brand-teal mb-4 inline-block rounded-full border bg-white/50 px-3 py-1 text-xs font-semibold tracking-[0.2em] uppercase backdrop-blur-sm"
      >
        Get in Touch
      </span>
      <h1 class="mb-6 font-serif text-5xl text-slate-900 md:text-6xl">
        Let's Start the <span class="teal-linear-text italic">Conversation</span
        >
      </h1>
      <p class="mx-auto max-w-lg text-lg font-light text-slate-600">
        Ready to optimize your financial operations? Contact our team for
        bespoke support and intelligence.
      </p>
    </div>
  </section>

  <section
    class="grid grid-cols-1 gap-x-16 gap-y-10 bg-white px-8 py-20 md:grid-cols-2 md:px-16 lg:py-32"
  >
    <ContactInfo />
    <ContactForm />
  </section>
</Layout>
