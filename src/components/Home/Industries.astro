---
import { Briefcase, Building2, Globe2, Users } from "@lucide/astro";

const industries = [
  {
    title: "Investments & Asset Managers",
    Icon: Briefcase,
  },
  {
    title: "Capital Market Intermediaries",
    Icon: Building2,
  },
  {
    title: "Professional Services & Advisors",
    Icon: Globe2,
  },
  {
    title: "Entrepreneurs & Startups",
    Icon: Users,
  },
];
---

<section id="industries" class="relative overflow-hidden bg-slate-50">
  <div
    class="bg-brand-teal/10 pointer-events-none absolute top-0 right-0 h-full w-1/3 blur-3xl"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mb-16 text-center" data-aos="fade-down">
      <h2 class="mb-4 font-serif text-4xl text-slate-900">
        Expertise for Every Industry
      </h2>
      <p class="text-slate-600">
        We understand the unique financial challenges of different businesses.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        industries.map(({ title, Icon }, index) => (
          <div
            data-aos="zoom-in"
            data-aos-delay={index * 100}
            class="hover:border-brand-teal group flex aspect-square flex-col items-center justify-center rounded-sm border border-slate-200 bg-white p-6 text-center transition-all duration-300 hover:shadow-lg"
          >
            <div class="text-brand-teal mb-4 transition-transform duration-300 group-hover:scale-110">
              <Icon class="h-9 w-9" />
            </div>
            <h3 class="font-serif text-lg text-slate-700 transition-colors group-hover:text-slate-900">
              {title}
            </h3>
          </div>
        ))
      }
    </div>
  </div>
</section>
