---
import { BarChart3, Check, Layers, PieChart, TrendingUp } from "@lucide/astro";

const services = [
  {
    title: "Transaction & Investment Analysis",
    description:
      "Specialized support for private market funds and investment banks. We assist with financial models, valuation support, and benchmarking studies.",
    Icon: BarChart3,
    features: [
      "Financial Modeling & Valuation Support",
      "Benchmarking & Data Analysis",
      "IC Memos, Pitch Decks & Management Reports",
    ],
  },
  {
    title: "Business Intelligence & Reporting",
    description:
      "Clear, decision-ready insights through Excel and BI-driven dashboards. We structure, analyze, and visualize data for strategic decisions.",
    Icon: PieChart,
    features: [
      "Custom Excel / BI Dashboards",
      "Performance & Trend Analysis",
      "Management Reporting Packs",
    ],
  },
  {
    title: "Accounting & Bookkeeping Support",
    description:
      "End-to-end back-office accounting assistance designed to maintain accuracy. Core accounting workflows, reconciliations, and management accounts.",
    Icon: Layers,
    features: [
      "GL, AP/AR & Reconciliations",
      "Month-End Close Activities",
      "Management Accounts Preparation",
    ],
  },
  {
    title: "Financial Planning & Analysis (FP&A)",
    description:
      "Structured FP&A support to strengthen internal planning. Budgets, forecasts, variance analysis, and KPI reporting for greater clarity.",
    Icon: TrendingUp,
    features: [
      "Budgeting & Forecasting",
      "Cash Flow Modeling",
      "Variance & KPI Analysis",
    ],
  },
];
---

<section id="services" class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 text-center" data-aos="fade-up">
      <span
        class="text-brand-teal mb-3 block text-xs font-bold tracking-[0.2em] uppercase"
      >
        Our Expertise
      </span>
      <h2 class="mb-4 font-serif text-4xl text-slate-900 md:text-5xl">
        Services We Offer
      </h2>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {
        services.map(({ title, description, Icon, features }, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={index * 100}
            class="group hover:border-brand-teal/50 relative overflow-hidden rounded-sm border border-slate-200 bg-white p-8 transition-all duration-300 hover:shadow-xl md:p-10"
          >
            {/* Background Icon - Faint Decoration */}
            <div class="text-brand-teal absolute top-0 right-0 p-6 opacity-5 transition-all duration-300 ease-in-out group-hover:translate-x-4 group-hover:-translate-y-4 group-hover:opacity-10">
              <Icon class="h-16 w-16" />
            </div>

            {/* Foreground Icon - Moves Up and Fades Out */}
            <div class="text-brand-teal mb-6 transition-all duration-300 ease-in-out group-hover:-translate-y-10 group-hover:opacity-0">
              <Icon class="h-8 w-8" />
            </div>

            {/* Content Wrapper - Moves Up to fill space */}
            <div class="relative z-10 transition-transform duration-300 ease-in-out group-hover:-translate-y-20">
              <h3 class="group-hover:text-brand-teal mb-4 font-serif text-2xl text-slate-900 transition-colors">
                {title}
              </h3>

              <p class="leading-relaxed text-slate-600">{description}</p>
            </div>

            {/* Features List - Absolute position, fades in from bottom */}
            <ul class="absolute right-8 bottom-10 left-8 translate-y-4 opacity-0 transition-all duration-300 ease-in-out group-hover:translate-y-0 group-hover:opacity-100 md:right-10 md:left-10">
              <div class="space-y-1 pt-4">
                {features.map((feature) => (
                  <li class="flex items-start gap-3 text-sm text-slate-700">
                    <Check
                      class="text-brand-teal mt-0.5 size-4 shrink-0"
                      aria-hidden="true"
                    />
                    <span>{feature}</span>
                  </li>
                ))}
              </div>
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
