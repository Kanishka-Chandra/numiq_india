---
import { BarChart3, Layers, PieChart, TrendingUp } from "@lucide/astro";

const services = [
  {
    title: "Transaction & Investment Analysis",
    description:
      "Specialized support for private market funds and investment banks. We assist with financial models, valuation support, and benchmarking studies.",
    Icon: BarChart3,
  },
  {
    title: "Business Intelligence & Reporting",
    description:
      "Clear, decision-ready insights through Excel and BI-driven dashboards. We structure, analyze, and visualize data for strategic decisions.",
    Icon: PieChart,
  },
  {
    title: "Accounting & Bookkeeping Support",
    description:
      "End-to-end back-office accounting assistance designed to maintain accuracy. Core accounting workflows, reconciliations, and management accounts.",
    Icon: Layers,
  },
  {
    title: "Financial Planning & Analysis (FP&A)",
    description:
      "Structured FP&A support to strengthen internal planning. Budgets, forecasts, variance analysis, and KPI reporting for greater clarity.",
    Icon: TrendingUp,
  },
];
---

<section id="services" class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 text-center" data-aos="fade-up">
      <span
        class="text-brand-teal mb-3 block text-xs font-bold tracking-[0.2em] uppercase"
      >
        Our Expertise
      </span>
      <h2 class="mb-4 font-serif text-4xl text-slate-900 md:text-5xl">
        Services We Offer
      </h2>
      <p class="mx-auto max-w-2xl text-slate-600">
        Numiq's team-as-a-service model refines workflows and enhances
        analytical depth, enabling you to focus on core competencies.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {
        services.map(({ title, description, Icon }, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={index * 100}
            class="group hover:border-brand-teal/50 relative overflow-hidden rounded-sm border border-slate-200 bg-white p-8 transition-all duration-300 hover:shadow-xl md:p-10"
          >
            {/* Background Icon */}
            <div class="text-brand-teal absolute top-0 right-0 p-6 opacity-5 transition-all duration-300 group-hover:opacity-10">
              <Icon class="h-16 w-16" />
            </div>

            {/* Foreground Icon */}
            <div class="text-brand-teal mb-6">
              <Icon class="h-8 w-8" />
            </div>

            <h3 class="group-hover:text-brand-teal mb-4 font-serif text-2xl text-slate-900 transition-colors">
              {title}
            </h3>

            <p class="mb-8 leading-relaxed text-slate-600">{description}</p>
            {/* 
            <a
              href="#contact"
              class="group-hover:text-brand-teal inline-flex items-center text-sm font-semibold tracking-widest text-slate-900 uppercase transition-colors"
            >
              Learn More
              <ArrowRight class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-2" />
            </a>
            */}
          </div>
        ))
      }
    </div>
  </div>
</section>
