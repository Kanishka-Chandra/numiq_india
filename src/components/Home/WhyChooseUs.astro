---
import { CheckCircle2 } from "@lucide/astro";

const reasons = [
  {
    title: "Consistent Delivery",
    description: "Rigorous review processes ensuring accuracy.",
  },
  {
    title: "AI & Tech Efficiency",
    description: "Leveraging modern tools to reduce manual effort.",
  },
  {
    title: "Integrity & Compliance",
    description: "Uncompromising commitment to data security.",
  },
];
---

<section id="why-us" class="bg-white">
  <div class="mx-auto max-w-7xl px-6">
    {/* Used dark navy block here to provide contrast anchor */}
    <div
      data-aos="fade-up"
      class="bg-brand-deep relative overflow-hidden rounded-sm p-8 shadow-2xl md:p-16"
    >
      <div
        class="via-brand-teal absolute top-0 left-0 h-1 w-full bg-linear-to-r from-transparent to-transparent"
      >
      </div>

      <div class="grid items-center gap-12 md:grid-cols-2">
        <div data-aos="fade-right" data-aos-delay="200">
          <h2 class="mb-6 font-serif text-4xl text-white">
            Why Partner With Us?
          </h2>
          <p class="mb-8 text-slate-400">
            In today's financial landscape, you need more than a service
            provider — you need a strategic finance partner. Numiq brings
            clarity, stability, and a competitive edge.
          </p>
          <a
            href="/contact"
            class="border-brand-teal text-brand-teal hover:bg-brand-teal inline-block border bg-transparent px-8 py-3 text-center text-sm tracking-widest uppercase transition-all hover:text-white"
          >
            Schedule a Discussion
          </a>
        </div>

        <div class="space-y-8">
          {
            reasons.map(({ title, description }, index) => (
              <div
                class="flex gap-4"
                data-aos="fade-left"
                data-aos-delay={index * 100 + 300}
              >
                <div class="mt-1">
                  <CheckCircle2 class="text-brand-teal h-6 w-6" />
                </div>
                <div>
                  <h3 class="mb-1 font-serif text-xl text-white">{title}</h3>
                  <p class="text-sm text-slate-500">{description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
