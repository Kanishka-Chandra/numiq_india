---
const steps = [
  {
    number: "01",
    title: "Structured Onboarding & Process",
    description:
      " Start by understanding your workflows end-to-end: who owns what, how data moves across systems/files, what the critical outputs are, so execution starts with clarity.",
  },
  {
    number: "02",
    title: "Three-Layer Execution & Quality Control",
    description:
      "Every deliverable runs through a three-layer workflow i.e. build, review, and value-add, so the final output is accurate, consistent, and decision-ready.",
  },
  {
    number: "03",
    title: "Prompt Alignment & Communication",
    description:
      "Run your engagement like an extension of your team with clear priorities, constant visibility, and fast iterations.",
  },
  {
    number: "04",
    title: "Workflow Optimization & Scale",
    description:
      "Once delivery is stable, we optimize by refining workflows, strengthen reporting, and improve analytical depth- while staying tightly connected to your team.",
  },
];
---

<section id="methodology" class="border-y border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 grid items-center justify-between gap-16 md:grid-cols-2">
      <h2
        data-aos="fade-right"
        class="font-serif text-4xl leading-tight text-slate-900 md:text-5xl"
      >
        The Numiq <br />
        Standard of Delivery
      </h2>
      <p data-aos="fade-left" class="text-lg text-slate-600">
        A rigorous, four-step methodology designed to ensure precision, maximize
        value, and mitigate risk for every client engagement.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      {
        steps.map(({ number, title, description }, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={index * 100}
            class="hover:border-brand-teal group relative border-t border-slate-300 pt-8 transition-colors duration-300"
          >
            <div class="group-hover:text-brand-teal mb-4 font-serif text-4xl text-slate-200 transition-colors">
              {number}
            </div>
            <h3 class="mb-2 font-serif text-xl text-slate-900">
              {title === "Workflow Optimization & Scale" ? (
                <>
                  Workflow Optimization &{" "}
                  <span class="block md:block">Scale</span>
                </>
              ) : (
                title
              )}
            </h3>

            <p class="text-sm text-slate-500 transition-colors group-hover:text-slate-700">
              {description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
