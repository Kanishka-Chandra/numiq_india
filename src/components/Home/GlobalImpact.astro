---
const impactStats = [
  {
    value: "500+",
    title: "Enterprises Served",
    description: "Trusted globally by leading firms.",
  },
  {
    value: "$2B+",
    title: "Assets Analyzed",
    description: "Detailed financial scrutiny.",
  },
  {
    value: "100%",
    title: "Compliance Rate",
    description: "Adhering to global standards.",
  },
];
---

<section id="impact" class="bg-brand-deep relative overflow-hidden">
  <div class="bg-brand-teal/10 absolute inset-0 mix-blend-overlay"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 text-center">
    <span
      class="border-brand-tealLight/30 text-brand-tealLight mb-8 inline-block rounded-full border bg-white/5 px-3 py-1 text-xs font-semibold tracking-[0.2em] uppercase backdrop-blur-sm"
    >
      Global Impact
    </span>

    <h2 class="mb-8 font-serif text-4xl leading-tight text-white md:text-6xl">
      Precision in Every Number. <br />
      <span class="text-brand-tealLight italic">Scale in Every Action.</span>
    </h2>

    <p
      class="mx-auto mb-12 max-w-3xl text-xl leading-relaxed font-light text-slate-300"
    >
      Our analytical rigor translates directly into tangible business results.
      We manage financial complexity through data, ensuring that every strategic
      decision is backed by empirical evidence and aligned with global best
      practices. We don't just count, we make it count.
    </p>

    <div
      class="mx-auto mt-16 grid max-w-4xl grid-cols-1 gap-8 border-t border-white/10 pt-12 text-left md:grid-cols-3"
    >
      {
        impactStats.map(({ value, title, description }) => (
          <div>
            <div class="text-brand-tealLight mb-2 font-serif text-4xl">
              {value}
            </div>
            <h4 class="mb-1 font-medium text-white">{title}</h4>
            <p class="text-sm text-slate-400">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
