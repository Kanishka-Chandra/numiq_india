---
import { FileBarChart2, Globe, LineChart } from "@lucide/astro";

const frameworkItems = [
  {
    title: "Analytical Rigor & Predictive Insight",
    description:
      "We combine structured financial analysis with data-driven forecasting techniques to help clients anticipate performance trajectories and identify operational patterns.",
    Icon: LineChart,
  },
  {
    title: "Global Delivery, Local Integration",
    description:
      "Our offshore model enables clients across geographies to extend their in-house analytical and finance teams seamlessly, adapting to diverse reporting norms.",
    Icon: Globe,
  },
  {
    title: "Consistent, Standardized Reporting",
    description:
      "We support clients in maintaining structured, comparable, and transparent reporting through well-defined financial models, dashboards, and documentation.",
    Icon: FileBarChart2,
  },
];
---

<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-6">
    <span
      data-aos="fade-right"
      class="text-brand-teal mb-3 block text-xs font-bold tracking-[0.2em] uppercase"
    >
      Our Framework
    </span>
    <div class="mb-16 grid items-center gap-16 md:grid-cols-2">
      <div>
        <h2
          data-aos="fade-right"
          class="font-serif text-4xl leading-tight text-slate-900 md:text-5xl"
        >
          Navigating the Global <br />
          Financial Landscape
        </h2>
      </div>
      <div>
        <p data-aos="fade-left" class="text-lg text-slate-600">
          Numiq commits trained talent that adds operating leverage and
          execution capacity to help you make informed decisions across the
          value chain of activities.
        </p>
      </div>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {
        frameworkItems.map(({ title, description, Icon }, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={index * 100}
            class="hover:border-brand-teal group rounded-sm border border-slate-200 bg-slate-50 p-8 transition-colors duration-300"
          >
            <div class="group-hover:border-brand-teal group-hover:bg-brand-teal mb-6 flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white transition-all duration-300">
              <Icon class="text-brand-teal h-6 w-6 transition-colors group-hover:text-white" />
            </div>

            <h3 class="mb-4 font-serif text-xl text-slate-900">{title}</h3>

            <p class="text-sm leading-relaxed text-slate-600">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
