---
import { ChevronDown } from "@lucide/astro";
---

<div
  class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-2xl shadow-slate-200/50"
>
  <div
    class="bg-brand-teal/5 pointer-events-none absolute top-0 right-0 -mt-20 -mr-20 h-64 w-64 rounded-full blur-[80px]"
  >
  </div>
  <div
    class="bg-brand-teal/5 pointer-events-none absolute bottom-0 left-0 -mb-20 -ml-20 h-64 w-64 rounded-full blur-[80px]"
  >
  </div>

  <div class="relative z-10">
    <h3 class="mb-6 font-serif text-2xl text-slate-900">Send us a Message</h3>
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      action="/contact"
      onsubmit="alert('Thank you. Your message has been sent to Numiq.');"
      class="space-y-6"
    >
      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-slate-700">
          Full Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="focus:border-brand-teal focus:ring-brand-teal/20 w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 placeholder-slate-400 transition-colors focus:ring focus:outline-none"
          placeholder="John Doe"
        />
      </div>

      <div>
        <label
          for="email"
          class="mb-1 block text-sm font-medium text-slate-700"
        >
          Business Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="focus:border-brand-teal focus:ring-brand-teal/20 w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 placeholder-slate-400 transition-colors focus:ring focus:outline-none"
          placeholder="john@company.com"
        />
      </div>

      <div>
        <label
          for="service"
          class="mb-1 block text-sm font-medium text-slate-700"
        >
          Service Requirement
        </label>
        <div class="relative">
          <select
            id="service"
            name="service"
            required
            class="focus:border-brand-teal focus:ring-brand-teal/20 w-full appearance-none rounded-lg border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 focus:ring focus:outline-none"
          >
            <option value="">Select a service...</option>
            <option value="transaction-and-investment-analysis"
              >Transaction & Investment Analysis</option
            >
            <option value="business-intelligence-and-reporting"
              >Business Intelligence & Reporting</option
            >
            <option value="accounting-and-bookkeeping-support"
              >Accounting & Bookkeeping Support</option
            >
            <option value="financial-planning-and-analysis-(fp&a)"
              >Financial Planning & Analysis (FP&A)</option
            >
            <option value="other">Other / General Inquiry</option>
          </select>

          <div
            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500"
          >
            <ChevronDown class="size-4" />
          </div>
        </div>
      </div>

      <div>
        <label
          for="message"
          class="mb-1 block text-sm font-medium text-slate-700"
        >
          Additional Remarks
        </label>
        <textarea
          id="message"
          name="message"
          rows="10"
          class="focus:border-brand-teal focus:ring-brand-teal/20 w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 placeholder-slate-400 transition-colors focus:ring focus:outline-none"
          placeholder="Please describe your specific requirements or challenges..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="bg-brand-teal hover:bg-brand-teal/90 hover:shadow-brand-teal/20 w-full transform rounded-full py-4 font-bold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:shadow-xl"
      >
        Submit Request
      </button>
    </form>
  </div>
</div>
